{
  "name": "peer-cdn",
  "version": "2.0.0",
  "description": "A peer-to-peer CDN for your site: a service worker serves assets from other visitors' caches over WebRTC before asking your server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "examples": "vite --config examples/vite.config.ts",
    "prepare": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vardius/peer-cdn.git"
  },
  "keywords": [
    "cdn",
    "vite-plugin",
    "peer-to-peer",
    "p2p",
    "webrtc",
    "service-worker",
    "cache",
    "offline"
  ],
  "author": {
    "name": "Rafał Lorenz",
    "email": "folksy.surges9p@icloud.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vardius/peer-cdn/issues"
  },
  "homepage": "https://vardius.github.io/peer-cdn/",
  "peerDependencies": {
    "socket.io": "^4.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "socket.io": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "peer-data": "github:vardius/peer-data#8dc4ee0c4fc5acd1cbe56e4b8885d3a0eb37377e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
